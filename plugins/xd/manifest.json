{
  "manifestVersion": 4,
  "id": "designport-xd-development",
  "name": "DesignPort XD",
  "version": "0.2.0",
  "main": "main.js",
  "host": {
    "app": "XD",
    "minVersion": "36.0.0"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "designportConnect",
      "label": {
        "default": "DesignPort Connect"
      }
    },
    {
      "type": "panel",
      "id": "designportPanel",
      "label": {
        "default": "DesignPort"
      },
      "minimumSize": {
        "width": 280,
        "height": 180
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 420
      }
    }
  ]
}
